@model QuanLyThuVien.Models.PhieuMuon
@{
    ViewData["Title"] = "Chi tiết Phiếu mượn #" + Model.MaPhieuMuon;
}

<div class="card border-0 shadow-sm mx-auto" style="max-width: 860px;">
    <div class="card-header bg-primary-custom text-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold">Chi Tiết Phiếu Mượn #@Model.MaPhieuMuon</h5>
        <span class="badge bg-light text-dark">@Model.TrangThai</span>
    </div>
    <div class="card-body p-4">
        <div class="row g-3 mb-4 bg-light rounded-3 p-3 border">
            <div class="col-md-6 small">
                <p class="mb-1 text-muted">Độc giả đăng ký: <strong class="text-dark">@Model.DocGia?.HoTen</strong> (Mã ĐG: #@Model.MaDocGia)</p>
                <p class="mb-0 text-muted">Ngày lập phiếu: <strong class="text-dark">@Model.NgayMuon.ToString("dd/MM/yyyy")</strong></p>
            </div>
            <div class="col-md-6 small">
                <p class="mb-1 text-muted">Hạn trả quy định: <strong class="text-danger">@Model.HanTra.ToString("dd/MM/yyyy")</strong></p>
                <p class="mb-0 text-muted">Trạng thái xử lý: <span class="badge bg-secondary bg-opacity-25 text-dark">@Model.TrangThai</span></p>
            </div>
        </div>

        <h6 class="fw-bold text-dark mb-3">Danh Sách Tài Liệu Trong Phiếu</h6>
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 50px;">Bìa</th>
                        <th>Tên đầu sách</th>
                        <th>Thể loại</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-center">Ngày trả</th>
                        <th class="text-center">Tình trạng</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var ct in Model.ChiTietPhieuMuons)
                    {
                        var imgPath = string.IsNullOrEmpty(ct.Sach?.HinhAnh) ? "/images/books/default-book.svg" : ct.Sach?.HinhAnh;
                        <tr>
                            <td class="text-center p-2">
                                <img src="@imgPath" alt="@ct.Sach?.TenSach" class="book-thumb-sm" onerror="this.src='/images/books/default-book.svg'" />
                            </td>
                            <td class="fw-semibold">
                                <a asp-controller="Sach" asp-action="Details" asp-route-id="@ct.MaSach" class="text-dark text-decoration-none">
                                    @ct.Sach?.TenSach
                                </a>
                                <div class="text-muted small">Mã: #@ct.MaSach</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                    @ct.Sach?.TheLoai?.TenTheLoai
                                </span>
                            </td>
                            <td class="text-center fw-bold text-primary">@ct.SoLuongMuon</td>
                            <td class="text-center">
                                @(ct.NgayTra.HasValue ? ct.NgayTra.Value.ToString("dd/MM/yyyy") : "Chưa trả")
                            </td>
                            <td class="text-center">
                                @if (ct.TinhTrangTra == "Đã trả đúng hạn")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Đã trả đúng hạn</span>
                                }
                                else if (ct.TinhTrangTra == "Trả quá hạn")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger">Trả quá hạn</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-25 text-dark">Chưa trả</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex gap-2 mt-4 pt-3 border-top">
            @if (Model.TrangThai == "Chờ xác nhận")
            {
                <form asp-action="HuyYeuCau" asp-route-id="@Model.MaPhieuMuon" method="post">
                    <button type="submit" class="btn btn-outline-danger fw-semibold" onclick="return confirm('Bạn có chắc muốn hủy yêu cầu mượn này?');">
                        Hủy yêu cầu mượn
                    </button>
                </form>
            }
            <a asp-action="SachDangMuon" class="btn btn-primary-custom">Sách đang mượn</a>
            <a asp-action="LichSuMuonTra" class="btn btn-outline-secondary">Lịch sử mượn trả</a>
        </div>
    </div>
</div>
