@model IEnumerable<QuanLyThuVien.Models.TaiKhoan>
@{
    ViewData["Title"] = "Quản lý Tài khoản Hệ thống";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-1">Quản Lý Tài Khoản Hệ Thống</h3>
        <small class="text-muted">Quản trị danh sách tài khoản Admin &amp; Độc giả, kích hoạt hoặc khóa tài khoản</small>
    </div>
    <a asp-controller="DocGia" asp-action="Create" class="btn btn-primary-custom fw-semibold">
        + Thêm Độc Giả &amp; Cấp Tài Khoản Mới
    </a>
</div>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 80px;">Mã TK</th>
                        <th>Tên đăng nhập</th>
                        <th>Họ và tên</th>
                        <th>Phân quyền</th>
                        <th>Hồ sơ Độc giả</th>
                        <th>Trạng thái</th>
                        <th class="text-center" style="width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@item.MaTaiKhoan</td>
                            <td><code>@item.TenDangNhap</code></td>
                            <td>@item.HoTen</td>
                            <td>
                                @if (item.VaiTro == "Admin")
                                {
                                    <span class="badge bg-warning bg-opacity-25 text-dark fw-bold">Admin Quản trị</span>
                                }
                                else
                                {
                                    <span class="badge bg-info bg-opacity-10 text-primary">Độc giả UNETI</span>
                                }
                            </td>
                            <td>
                                @if (item.DocGia != null)
                                {
                                    <a asp-controller="DocGia" asp-action="Details" asp-route-id="@item.DocGia.MaDocGia" class="text-decoration-none">
                                        Mã ĐG: #@item.DocGia.MaDocGia
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (item.TrangThai == "Hoạt động")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger">Bị khóa</span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="DoiTrangThai" asp-route-id="@item.MaTaiKhoan" method="post" class="d-inline">
                                    @if (item.TrangThai == "Hoạt động")
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc muốn tạm khóa tài khoản @item.TenDangNhap?');">
                                            Khóa tài khoản
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            Mở khóa
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
