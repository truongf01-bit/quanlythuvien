@{
    ViewData["Title"] = "Đăng nhập Cổng Thư viện";
}

<div class="login-container">
    <div class="row g-0">

        <div class="col-lg-6 d-none d-lg-block login-art-panel position-relative">
            <div class="mb-4">
                <span class="badge bg-light text-primary px-3 py-2 fw-semibold rounded-pill mb-3">
                    TRƯỜNG ĐẠI HỌC KINH TẾ - KỸ THUẬT CÔNG NGHIỆP
                </span>
                <h2 class="fw-bold text-white mb-2">Thư viện Đại học UNETI</h2>
                <p class="text-white-50">Cổng thông tin tra cứu tài liệu học tập, giáo trình và đăng ký mượn trả trực tuyến dành cho Cán bộ &amp; Sinh viên.</p>
            </div>

            <div class="bg-white bg-opacity-10 border border-white border-opacity-15 rounded-3 p-3 mb-3">
                <div class="fw-semibold text-warning mb-2">🎁 Quyền lợi &amp; Tiện ích khi đăng ký thành viên:</div>
                <div class="small text-white-50 mb-1">📚 <strong>Mượn giáo trình miễn phí:</strong> Tiếp cận kho tài liệu học thuật và giáo trình chuyên ngành cập nhật mới nhất.</div>
                <div class="small text-white-50 mb-1">⚡ <strong>Đăng ký mượn online 24/7:</strong> Giữ sách nhanh chóng ngay trên cổng thông tin mọi lúc mọi nơi.</div>
                <div class="small text-white-50 mb-1">🔔 <strong>Chủ động quản lý hạn trả:</strong> Theo dõi danh sách sách đang mượn và nhận thông báo nhắc hạn kịp thời.</div>
                <div class="small text-white-50">💡 <strong>Đặc quyền sinh viên:</strong> Sử dụng không gian tự học hiện đại, hệ thống máy tính tra cứu và tài nguyên số.</div>
            </div>

            <div class="bg-white bg-opacity-10 border border-white border-opacity-15 rounded-3 p-3 mb-4">
                <div class="fw-semibold text-warning mb-2">⏰ Thời gian phục vụ:</div>
                <div class="small text-white-50 mb-1">• Thứ 2 - Thứ 6: 07:30 - 20:30</div>
                <div class="small text-white-50 mb-1">• Thứ 7: 08:00 - 17:00 (Nghỉ Chủ nhật &amp; Ngày lễ)</div>
                <div class="small text-white-50">• Địa điểm: Tòa nhà Thư viện - Cơ sở Lĩnh Nam &amp; Minh Khai</div>
            </div>

            <div class="mt-auto small text-white-50">
                &copy; 2026 Trung tâm Thông tin - Thư viện UNETI.
            </div>
        </div>

        <div class="col-lg-6 login-form-panel d-flex flex-column justify-content-center">
            <div class="mb-4 text-center text-lg-start">
                <h3 class="fw-bold text-dark mb-1">Đăng nhập Hệ thống</h3>
                <p class="text-muted small mb-0">Sử dụng tài khoản thư viện hoặc mã sinh viên để đăng nhập</p>
            </div>

            @if (ViewBag.Loi != null)
            {
                <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                    <span>@ViewBag.Loi</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="DangNhap" method="post">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Tên đăng nhập / Mã tài khoản</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">👤</span>
                        <input type="text" id="tenDangNhap" name="tenDangNhap" value="@(ViewBag.TenDangNhap ?? "")" class="form-control border-start-0 ps-0" placeholder="Nhập tên đăng nhập (VD: admin, docgia1...)" required autofocus />
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-semibold text-secondary mb-0">Mật khẩu</label>
                        <a href="javascript:void(0)" onclick="alert('Vui lòng liên hệ trực tiếp quầy Thủ thư tại Tầng 1 Thư viện để được cấp lại mật khẩu.')" class="small text-decoration-none text-muted">Quên mật khẩu?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0">🔒</span>
                        <input type="password" id="matKhau" name="matKhau" class="form-control border-start-0 ps-0" placeholder="Nhập mật khẩu..." required />
                        <button class="btn btn-outline-light border text-muted" type="button" onclick="togglePassword()">👁️</button>
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="rememberMe" checked>
                    <label class="form-check-label small text-muted" for="rememberMe">Duy trì trạng thái đăng nhập trên thiết bị này</label>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary-custom btn-lg fs-6 py-2">
                        Đăng nhập vào Hệ thống
                    </button>
                </div>

                <div class="mt-3 text-center">
                    <span class="text-muted small">Chưa có thẻ thư viện? </span>
                    <a asp-action="DangKy" class="small fw-bold text-primary text-decoration-none">
                        Đăng ký tài khoản Độc giả &rarr;
                    </a>
                </div>
            </form>

            <div class="mt-4 pt-3 border-top text-center text-muted small">
                <span>Cần trợ giúp kỹ thuật? Liên hệ ban quản trị: <a href="mailto:thuvien@uneti.edu.vn" class="text-decoration-none">thuvien@uneti.edu.vn</a></span>
                <div class="mt-2">
                    <button type="button" class="btn-subtle-hint" data-bs-toggle="modal" data-bs-target="#demoAccountsModal">
                        📋 Dành cho Giảng viên chấm đồ án: Xem danh sách tài khoản demo
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="demoAccountsModal" tabindex="-1" aria-labelledby="demoAccountsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white py-2">
                <h6 class="modal-title fw-bold" id="demoAccountsModalLabel">
                    📋 Danh sách Tài khoản Kiểm thử Đồ án
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <p class="text-muted small mb-2">Thầy/Cô và các bạn có thể bấm vào nút <strong>Chọn</strong> để tự động điền tài khoản mẫu vào form đăng nhập:</p>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Vai trò</th>
                                <th>Tài khoản</th>
                                <th>Mật khẩu</th>
                                <th>Mục đích</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            <tr>
                                <td><span class="badge bg-warning text-dark">Admin</span></td>
                                <td><code>admin</code></td>
                                <td><code>123456</code></td>
                                <td>Quản trị toàn bộ thư viện</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2" onclick="dienNhanh('admin', '123456')">Chọn</button>
                                </td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-info text-dark">Độc giả 1</span></td>
                                <td><code>docgia1</code></td>
                                <td><code>123456</code></td>
                                <td>Có sẵn lịch sử &amp; phiếu quá hạn</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2" onclick="dienNhanh('docgia1', '123456')">Chọn</button>
                                </td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-info text-dark">Độc giả 2</span></td>
                                <td><code>docgia2</code></td>
                                <td><code>123456</code></td>
                                <td>Đăng ký mượn mới</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2" onclick="dienNhanh('docgia2', '123456')">Chọn</button>
                                </td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-secondary">Độc giả 15</span></td>
                                <td><code>docgia15</code></td>
                                <td><code>123456</code></td>
                                <td>Test tài khoản bị khóa</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2" onclick="dienNhanh('docgia15', '123456')">Chọn</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng lại</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function dienNhanh(tk, mk) {
            document.getElementById('tenDangNhap').value = tk;
            document.getElementById('matKhau').value = mk;

            var modalEl = document.getElementById('demoAccountsModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
        }

        function togglePassword() {
            var input = document.getElementById('matKhau');
            if (input.type === 'password') {
                input.type = 'text';
            } else {
                input.type = 'password';
            }
        }
    </script>
}
