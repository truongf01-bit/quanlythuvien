@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var maTaiKhoan = HttpContextAccessor.HttpContext?.Session.GetInt32("MaTaiKhoan");
    var hoTen = HttpContextAccessor.HttpContext?.Session.GetString("HoTen");
    var vaiTro = HttpContextAccessor.HttpContext?.Session.GetString("VaiTro");
    bool laAdmin = (vaiTro == "Admin");
    bool laDocGia = (vaiTro == "DocGia");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thư viện Đại học UNETI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white text-decoration-none" asp-controller="Home" asp-action="Index">
                    <span class="fs-4">📖</span>
                    <span>
                        <span class="d-block lh-1 text-white" style="font-size: 1.05rem;">THƯ VIỆN ĐẠI HỌC UNETI</span>
                        <small class="d-block text-white-50" style="font-size: 0.72rem; letter-spacing: 0.5px;">CỔNG THÔNG TIN HỌC THUẬT &amp; TRA CỨU</small>
                    </span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Sach" asp-action="Index">Tra cứu Sách</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold d-flex align-items-center gap-1" asp-controller="ThanhToan" asp-action="Index">
                                <span>💳</span> Thanh toán QR
                            </a>
                        </li>

                        @if (laDocGia)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="MuonSach" asp-action="DangKyMuon">Đăng ký mượn</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-controller="MuonSach" asp-action="SachDangMuon">Sách đang mượn</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-controller="MuonSach" asp-action="LichSuMuonTra">Lịch sử mượn trả</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-controller="DocGia" asp-action="ThongTinCaNhan">Hồ sơ cá nhân</a>
                            </li>
                        }

                        @if (laAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="ThongKe" asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
                                    Quản trị Thư viện
                                </a>
                                <ul class="dropdown-menu shadow border-0 py-2">
                                    <li><h6 class="dropdown-header text-uppercase small text-muted">Danh mục &amp; Kho sách</h6></li>
                                    <li><a class="dropdown-item" asp-controller="TheLoai" asp-action="Index">Quản lý Thể loại sách</a></li>
                                    <li><a class="dropdown-item" asp-controller="Sach" asp-action="Index">Quản lý Đầu sách &amp; Kho</a></li>
                                    <li><hr class="dropdown-divider" /></li>

                                    <li><h6 class="dropdown-header text-uppercase small text-muted">Độc giả &amp; Tài khoản</h6></li>
                                    <li><a class="dropdown-item" asp-controller="DocGia" asp-action="Index">Danh sách Độc giả</a></li>
                                    <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="Index">Quản lý Tài khoản</a></li>
                                    <li><hr class="dropdown-divider" /></li>

                                    <li><h6 class="dropdown-header text-uppercase small text-muted">Lưu thông &amp; Thống kê</h6></li>
                                    <li><a class="dropdown-item fw-semibold text-primary" asp-controller="PhieuMuon" asp-action="Index">Duyệt Phiếu Mượn &amp; Trả</a></li>
                                    <li><a class="dropdown-item fw-semibold text-danger" asp-controller="PhieuMuon" asp-action="QuaHan">Danh sách Quá hạn</a></li>
                                    <li><a class="dropdown-item fw-semibold text-success" asp-controller="ThongKe" asp-action="Index">Báo cáo Thống kê LINQ</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                        @if (maTaiKhoan != null)
                        {
                            var avatarFile = laAdmin ? "/images/avatars/avatar-admin.svg" : "/images/avatars/avatar-student.svg";
                            <div class="d-flex align-items-center gap-2 me-2">
                                <img src="@avatarFile" alt="Avatar" style="width: 32px; height: 32px; border-radius: 50%;" />
                                <div class="text-end d-none d-sm-block">
                                    <div class="text-white small fw-bold lh-1">@hoTen</div>
                                    <small class="badge @(laAdmin ? "bg-warning text-dark" : "bg-info text-dark")" style="font-size: 0.65rem;">
                                        @(laAdmin ? "Quản trị viên" : "Độc giả UNETI")
                                    </small>
                                </div>
                            </div>
                            <a class="btn btn-sm btn-outline-light py-1 px-3 fw-semibold" asp-controller="TaiKhoan" asp-action="DangXuat">
                                Đăng xuất
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light text-white fw-semibold px-3 py-1 rounded-pill" asp-controller="TaiKhoan" asp-action="DangKy">
                                Đăng ký
                            </a>
                            <a class="btn btn-sm btn-warning text-dark fw-bold px-3 py-1 rounded-pill" asp-controller="TaiKhoan" asp-action="DangNhap">
                                Đăng nhập
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                <strong>Thành công:</strong> @TempData["ThongBao"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Loi"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                <strong>Thông báo:</strong> @TempData["Loi"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom py-4 mt-auto">
        <div class="container">
            <div class="row g-4 small">
                <div class="col-md-5">
                    <h6 class="text-white fw-bold mb-2">TRUNG TÂM THÔNG TIN - THƯ VIỆN UNETI</h6>
                    <p class="text-white-50 mb-1">Trường Đại học Kinh tế - Kỹ thuật Công nghiệp</p>
                    <p class="text-white-50 mb-1">• Cơ sở Hà Nội: 218 Lĩnh Nam, Q. Hoàng Mai / 456 Minh Khai, Q. Hai Bà Trưng</p>
                    <p class="text-white-50 mb-0">• Cơ sở Nam Định: 353 Trần Hưng Đạo, TP. Nam Định</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-white fw-bold mb-2">LIÊN KẾT NHANH</h6>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ Thư viện</a></li>
                        <li><a asp-controller="Sach" asp-action="Index">Tra cứu danh mục sách</a></li>
                        <li><a asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký thẻ độc giả mới</a></li>
                        <li><a asp-controller="ThanhToan" asp-action="Index">Thanh toán cọc / phạt qua QR</a></li>
                        <li><a asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập tài khoản sinh viên</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white fw-bold mb-2">ĐỀ TÀI ĐỒ ÁN MÔN HỌC</h6>
                    <p class="text-white-50 mb-1">Môn: <strong>Thực hành Lập trình .NET</strong> (ASP.NET Core 10 MVC)</p>
                    <p class="text-white-50 mb-1">Đề tài 02: Hệ thống Quản lý Thư viện &amp; Mượn trả sách</p>
                    <p class="text-white-50 mb-0">Nhóm thực hiện: <strong>Trương Trọng Cường</strong> (trưởng nhóm), thành viên: <strong>Nguyễn Xuân Trường, Nguyễn Viết Hồng, Đặng Xuân Tình</strong></p>
                </div>
            </div>
            <div class="border-top border-secondary border-opacity-25 mt-4 pt-3 text-center text-white-50" style="font-size: 0.8rem;">
                &copy; 2026 Thư viện Đại học UNETI. Bản quyền đồ án thuộc về Nhóm sinh viên thực hiện.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
