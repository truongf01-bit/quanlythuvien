@model QuanLyThuVien.Models.Sach
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = Model.TenSach;
    bool laAdmin = HttpContextAccessor.HttpContext?.Session.GetString("VaiTro") == "Admin";
    var imgCover = string.IsNullOrEmpty(Model.HinhAnh) ? "/images/books/default-book.svg" : Model.HinhAnh;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Sach" asp-action="Index" class="text-decoration-none">Danh mục Sách</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.TenSach</li>
    </ol>
</nav>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-4 align-items-start">

            <div class="col-md-5 col-lg-4 text-center">
                <div class="position-relative d-inline-block">
                    <img src="@imgCover"
                         alt="@Model.TenSach"
                         class="detail-book-cover"
                         onerror="this.src='/images/books/default-book.svg'" />
                </div>
                <div class="mt-3">
                    <span class="badge bg-light text-dark border px-3 py-2">
                        Mã tài liệu: <strong>#@Model.MaSach</strong>
                    </span>
                </div>
            </div>

            <div class="col-md-7 col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold px-2 py-1">
                        @Model.TheLoai?.TenTheLoai
                    </span>
                    @if (Model.TrangThai == "Đang phục vụ")
                    {
                        <span class="badge bg-success bg-opacity-10 text-success fw-semibold px-2 py-1">
                            Đang phục vụ
                        </span>
                    }
                    else if (Model.TrangThai == "Tạm ngừng")
                    {
                        <span class="badge bg-warning bg-opacity-25 text-dark fw-semibold px-2 py-1">
                            Tạm ngừng
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary bg-opacity-10 text-secondary fw-semibold px-2 py-1">
                            Ngừng phục vụ
                        </span>
                    }
                </div>

                <h3 class="fw-bold text-dark mb-3">@Model.TenSach</h3>

                <div class="bg-light rounded-3 p-3 mb-4">
                    <div class="row g-2 small">
                        <div class="col-sm-6">
                            <span class="text-muted">Tác giả:</span>
                            <strong class="text-dark ms-1">@Model.TacGia</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Nhà xuất bản:</span>
                            <strong class="text-dark ms-1">@Model.NhaXuatBan</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Năm phát hành:</span>
                            <strong class="text-dark ms-1">@Model.NamXuatBan</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Giá niêm yết:</span>
                            <strong class="text-primary ms-1">@Model.GiaSach.ToString("N0") VNĐ</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Tổng số lượng lưu kho:</span>
                            <strong class="text-dark ms-1">@Model.SoLuong cuốn</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Hiện còn trên kệ:</span>
                            <strong class="@(Model.SoLuongCon > 0 ? "text-success" : "text-danger") ms-1">
                                @Model.SoLuongCon cuốn
                            </strong>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-2">Tóm tắt nội dung:</h6>
                    <p class="text-secondary leading-relaxed mb-0">
                        @(string.IsNullOrEmpty(Model.MoTa) ? "Đầu sách này hiện chưa có phần mô tả tóm tắt chi tiết từ ban quản lý thư viện." : Model.MoTa)
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-2 pt-3 border-top">
                    @if (Model.TrangThai == "Đang phục vụ" && Model.SoLuongCon > 0)
                    {
                        <a asp-controller="MuonSach" asp-action="DangKyMuon" asp-route-maSach="@Model.MaSach" class="btn btn-primary-custom px-4 fw-semibold">
                            Đăng Ký Mượn Cuốn Sách Này
                        </a>
                    }
                    else if (Model.SoLuongCon <= 0)
                    {
                        <button class="btn btn-secondary" disabled>
                            Tạm hết sách (Vui lòng chờ độc giả khác trả)
                        </button>
                    }

                    @if (laAdmin)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.MaSach" class="btn btn-outline-warning fw-semibold">
                            Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.MaSach" class="btn btn-outline-danger fw-semibold">
                            Xóa sách
                        </a>
                    }

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        &larr; Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
