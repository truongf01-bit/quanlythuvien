@model QuanLyThuVien.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển Quản trị";
    DateTime homNay = DateTime.Today;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-1">Bảng Điều Khiển Quản Trị Thư Viện</h3>
        <small class="text-muted">Tổng quan số liệu vận hành, lưu thông tài liệu và xử lý mượn trả thời gian thực</small>
    </div>
    <a asp-action="Index" class="btn btn-primary-custom fw-semibold">
        Xem Báo Cáo Thống Kê &rarr;
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
            <div class="card-body p-3">
                <div class="text-secondary small fw-semibold">Tổng số đầu sách</div>
                <div class="fs-3 fw-bold text-dark my-1">@Model.TongDauSach</div>
                <a asp-controller="Sach" asp-action="Index" class="small text-decoration-none">Quản lý kho sách &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-info">
            <div class="card-body p-3">
                <div class="text-secondary small fw-semibold">Chuyên mục thể loại</div>
                <div class="fs-3 fw-bold text-dark my-1">@Model.TongTheLoai</div>
                <a asp-controller="TheLoai" asp-action="Index" class="small text-decoration-none">Xem các thể loại &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
            <div class="card-body p-3">
                <div class="text-secondary small fw-semibold">Độc giả thành viên</div>
                <div class="fs-3 fw-bold text-dark my-1">@Model.TongDocGia</div>
                <a asp-controller="DocGia" asp-action="Index" class="small text-decoration-none">Hồ sơ độc giả &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-secondary">
            <div class="card-body p-3">
                <div class="text-secondary small fw-semibold">Tổng lượt mượn trả</div>
                <div class="fs-3 fw-bold text-dark my-1">@Model.TongPhieuMuon</div>
                <a asp-controller="PhieuMuon" asp-action="Index" class="small text-decoration-none">Toàn bộ phiếu &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
            <div class="card-body p-3">
                <div class="text-secondary small fw-semibold">Yêu cầu chờ duyệt</div>
                <div class="fs-3 fw-bold text-warning my-1">@Model.PhieuChoXacNhan</div>
                <a asp-controller="PhieuMuon" asp-action="Index" asp-route-trangThai="Chờ xác nhận" class="small text-decoration-none">Duyệt mượn ngay &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
            <div class="card-body p-3">
                <div class="text-secondary small fw-semibold">Phiếu đang mượn</div>
                <div class="fs-3 fw-bold text-primary my-1">@Model.PhieuDangMuon</div>
                <a asp-controller="PhieuMuon" asp-action="Index" asp-route-trangThai="Đang mượn" class="small text-decoration-none">Danh sách lưu thông &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-danger">
            <div class="card-body p-3">
                <div class="text-secondary small fw-semibold">Tài liệu quá hạn</div>
                <div class="fs-3 fw-bold text-danger my-1">@Model.TruongHopQuaHan</div>
                <a asp-controller="PhieuMuon" asp-action="QuaHan" class="small text-danger text-decoration-none fw-semibold">Theo dõi quá hạn &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
            <div class="card-body p-3">
                <div class="text-secondary small fw-semibold">Sách sẵn sàng phục vụ</div>
                <div class="fs-3 fw-bold text-success my-1">@Model.TongSachConCoTheMuon <span class="fs-6 fw-normal text-muted">cuốn</span></div>
                <span class="small text-muted">Hiện còn trên kệ</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark">Yêu Cầu Mượn Sách Chờ Duyệt</h6>
                <a asp-controller="PhieuMuon" asp-action="Index" asp-route-trangThai="Chờ xác nhận" class="btn btn-xs btn-outline-secondary">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0 align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Độc giả</th>
                                <th>Ngày đăng ký</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @if (!Model.DanhSachChoXacNhan.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">Không có yêu cầu nào đang chờ xác nhận</td>
                                </tr>
                            }
                            @foreach (var pm in Model.DanhSachChoXacNhan)
                            {
                                <tr>
                                    <td class="fw-bold">#@pm.MaPhieuMuon</td>
                                    <td>@pm.DocGia?.HoTen</td>
                                    <td>@pm.NgayMuon.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <a asp-controller="PhieuMuon" asp-action="Details" asp-route-id="@pm.MaPhieuMuon" class="btn btn-xs btn-primary-custom py-0 px-2">Xử lý</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-danger">Danh Sách Tài Liệu Quá Hạn Trả</h6>
                <a asp-controller="PhieuMuon" asp-action="QuaHan" class="btn btn-xs btn-outline-danger">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0 align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Độc giả</th>
                                <th>Hạn trả</th>
                                <th>Trễ hạn</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @if (!Model.DanhSachQuaHan.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">Hiện không có trường hợp nào quá hạn</td>
                                </tr>
                            }
                            @foreach (var pm in Model.DanhSachQuaHan)
                            {
                                <tr>
                                    <td class="fw-bold">#@pm.MaPhieuMuon</td>
                                    <td>@pm.DocGia?.HoTen</td>
                                    <td class="text-danger fw-semibold">@pm.HanTra.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-danger bg-opacity-10 text-danger">@((homNay - pm.HanTra.Date).Days) ngày</span></td>
                                    <td class="text-center">
                                        <a asp-controller="PhieuMuon" asp-action="TraSach" asp-route-id="@pm.MaPhieuMuon" class="btn btn-xs btn-outline-success py-0 px-2">Thu hồi</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
