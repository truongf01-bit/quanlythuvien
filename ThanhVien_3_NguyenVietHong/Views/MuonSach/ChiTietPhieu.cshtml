@model QuanLyThuVien.Models.PhieuMuon
@{
    ViewData["Title"] = "Chi tiết Phiếu mượn #" + Model.MaPhieuMuon;
    var cacGiaoDich = Model.GiaoDichThanhToans?.OrderByDescending(g => g.NgayGiaoDich).ToList() ?? new List<QuanLyThuVien.Models.GiaoDichThanhToan>();
    decimal tongVao = cacGiaoDich.Where(g => g.HuongDongTien == "Nguồn vào" && g.TrangThai != "Đã hủy").Sum(g => g.SoTien);
    decimal tongRa = cacGiaoDich.Where(g => g.HuongDongTien == "Nguồn ra" && g.TrangThai != "Đã hủy").Sum(g => g.SoTien);
    decimal tienCocConLai = tongVao - tongRa;
}

<div class="card border-0 shadow-sm mx-auto" style="max-width: 900px;">
    <div class="card-header bg-primary-custom text-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold">Chi Tiết Phiếu Mượn #@Model.MaPhieuMuon</h5>
        <span class="badge bg-light text-dark">@Model.TrangThai</span>
    </div>
    <div class="card-body p-4">
        <!-- Thông tin phiếu -->
        <div class="row g-3 mb-4 bg-light rounded-3 p-3 border">
            <div class="col-md-6 small">
                <p class="mb-1 text-muted">Độc giả đăng ký: <strong class="text-dark">@Model.DocGia?.HoTen</strong> (Mã ĐG: #@Model.MaDocGia)</p>
                <p class="mb-0 text-muted">Ngày lập phiếu: <strong class="text-dark">@Model.NgayMuon.ToString("dd/MM/yyyy")</strong></p>
            </div>
            <div class="col-md-6 small">
                <p class="mb-1 text-muted">Hạn trả quy định: <strong class="text-danger">@Model.HanTra.ToString("dd/MM/yyyy")</strong></p>
                <p class="mb-0 text-muted">Trạng thái xử lý: <span class="badge bg-secondary bg-opacity-25 text-dark">@Model.TrangThai</span></p>
            </div>
        </div>

        <!-- Bảng danh sách sách -->
        <h6 class="fw-bold text-dark mb-3">Danh Sách Tài Liệu Trong Phiếu</h6>
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 50px;">Bìa</th>
                        <th>Tên đầu sách</th>
                        <th>Thể loại</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-center">Ngày trả</th>
                        <th class="text-center">Tình trạng</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var ct in Model.ChiTietPhieuMuons)
                    {
                        var imgPath = string.IsNullOrEmpty(ct.Sach?.HinhAnh) ? "/images/books/default-book.svg" : ct.Sach?.HinhAnh;
                        <tr>
                            <td class="text-center p-2">
                                <img src="@imgPath" alt="@ct.Sach?.TenSach" class="book-thumb-sm" onerror="this.src='/images/books/default-book.svg'" />
                            </td>
                            <td class="fw-semibold">
                                <a asp-controller="Sach" asp-action="Details" asp-route-id="@ct.MaSach" class="text-dark text-decoration-none">
                                    @ct.Sach?.TenSach
                                </a>
                                <div class="text-muted small">Mã: #@ct.MaSach</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                    @ct.Sach?.TheLoai?.TenTheLoai
                                </span>
                            </td>
                            <td class="text-center fw-bold text-primary">@ct.SoLuongMuon</td>
                            <td class="text-center">
                                @(ct.NgayTra.HasValue ? ct.NgayTra.Value.ToString("dd/MM/yyyy") : "Chưa trả")
                            </td>
                            <td class="text-center">
                                @if (ct.NgayTra.HasValue || Model.TrangThai == "Đã trả")
                                {
                                    @if (ct.TinhTrangTra == "Mất sách")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger">Mất sách</span>
                                    }
                                    else if (ct.TinhTrangTra == "Hư hỏng nhẹ")
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-dark">Đã trả (Hư hỏng nhẹ)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">Đã trả (@(string.IsNullOrEmpty(ct.TinhTrangTra) || ct.TinhTrangTra == "Chưa trả" ? "Tốt" : ct.TinhTrangTra))</span>
                                    }
                                }
                                else if (Model.TrangThai == "Đã hủy" || ct.TinhTrangTra == "Đã hủy")
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Đã hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-25 text-dark">Chưa trả</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- LỊCH SỬ DÒNG TIỀN PHIẾU MƯỢN CHO ĐỘC GIẢ -->
        <div class="card border border-primary border-opacity-25 rounded-3 mb-4 shadow-sm">
            <div class="card-header bg-primary bg-opacity-10 py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-primary d-flex align-items-center gap-2">
                    <span>💳</span> Lịch Sử Dòng Tiền &amp; Thanh Toán Của Phiếu
                </h6>
                <div>
                    <a asp-controller="ThanhToan" asp-action="Index" asp-route-maPhieuMuon="@Model.MaPhieuMuon" class="btn btn-xs btn-outline-primary fw-semibold">
                        Nộp cọc / Phạt QR
                    </a>
                </div>
            </div>
            <div class="card-body p-3">
                <div class="row g-2 mb-3 text-center small">
                    <div class="col-md-4">
                        <div class="p-2 border rounded-2 bg-light">
                            <span class="text-muted">📥 Tiền bạn đã nộp (Nguồn vào):</span>
                            <div class="fw-bold text-success mt-1">+@tongVao.ToString("N0") VNĐ</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-2 border rounded-2 bg-light">
                            <span class="text-muted">📤 Tiền thư viện đã hoàn (Nguồn ra):</span>
                            <div class="fw-bold text-danger mt-1">-@tongRa.ToString("N0") VNĐ</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-2 border rounded-2 bg-light">
                            <span class="text-muted">💵 Tiền cọc đang lưu giữ:</span>
                            <div class="fw-bold text-primary mt-1">@tienCocConLai.ToString("N0") VNĐ</div>
                        </div>
                    </div>
                </div>

                @if (cacGiaoDich.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã GD</th>
                                    <th>Thời gian</th>
                                    <th>Dòng tiền</th>
                                    <th>Mục đích</th>
                                    <th>💸 Nguồn ra của tiền</th>
                                    <th>📥 Nguồn vào của tiền</th>
                                    <th class="text-end">Số tiền</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var gd in cacGiaoDich)
                                {
                                    bool isRa = gd.HuongDongTien == "Nguồn ra";
                                    <tr>
                                        <td>
                                            <a asp-controller="ThanhToan" asp-action="ChiTiet" asp-route-id="@gd.MaGiaoDich" class="text-decoration-none fw-bold font-monospace text-primary">
                                                @gd.MaGiaoDichCode
                                            </a>
                                        </td>
                                        <td>@gd.NgayGiaoDich.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (isRa)
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">📤 Nguồn ra</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">📥 Nguồn vào</span>
                                            }
                                        </td>
                                        <td>@gd.LoaiThanhToan</td>
                                        <td><span class="text-danger small">@gd.NguonTienRa</span></td>
                                        <td><span class="text-success small">@gd.NguonTienVao</span></td>
                                        <td class="text-end fw-bold @(isRa ? "text-danger" : "text-success")">
                                            @(isRa ? "-" : "+")@gd.SoTien.ToString("N0") đ
                                        </td>
                                        <td>
                                            <span class="badge @(gd.TrangThai == "Đã hoàn thành" ? "bg-success" : "bg-warning text-dark")">
                                                @gd.TrangThai
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-2 text-muted small bg-light rounded-2 border">
                        Chưa có chứng từ giao dịch nào liên kết với phiếu mượn này.
                    </div>
                }
            </div>
        </div>

        <!-- Nút thao tác -->
        <div class="d-flex gap-2 mt-4 pt-3 border-top">
            @if (Model.TrangThai == "Chờ xác nhận")
            {
                <form asp-action="HuyYeuCau" asp-route-id="@Model.MaPhieuMuon" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger fw-semibold" onclick="return confirm('Bạn có chắc muốn hủy yêu cầu mượn này?');">
                        Hủy yêu cầu mượn
                    </button>
                </form>
            }
            <a asp-action="SachDangMuon" class="btn btn-primary-custom">Sách đang mượn</a>
            <a asp-action="LichSuMuonTra" class="btn btn-outline-secondary">Lịch sử mượn trả</a>
        </div>
    </div>
</div>
