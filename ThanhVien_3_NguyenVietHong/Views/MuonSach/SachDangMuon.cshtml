@model IEnumerable<QuanLyThuVien.Models.PhieuMuon>
@{
    ViewData["Title"] = "Sách đang mượn & Chờ xác nhận";
    DateTime homNay = DateTime.Today;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-1">Tài Liệu Đang Mượn &amp; Yêu Cầu Chờ Duyệt</h3>
        <small class="text-muted">Theo dõi danh sách các phiếu mượn cá nhân và thời hạn trả tài liệu</small>
    </div>
    <a asp-action="DangKyMuon" class="btn btn-primary-custom fw-semibold">
        + Đăng Ký Mượn Thêm
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <h5 class="fw-bold text-dark mb-2">Hiện tại bạn không có tài liệu nào đang mượn hoặc chờ duyệt</h5>
            <p class="text-muted small mb-3">Bạn có thể tra cứu và đăng ký mượn các giáo trình mới từ thư viện.</p>
            <a asp-controller="Sach" asp-action="Index" class="btn btn-sm btn-primary-custom">
                Khám phá Danh mục Sách
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 80px;">Mã phiếu</th>
                        <th>Ngày đăng ký</th>
                        <th>Hạn trả sách</th>
                        <th>Danh sách đầu sách trong phiếu</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width: 170px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var pm in Model)
                    {
                        bool quaHan = (pm.TrangThai == "Đang mượn" && pm.HanTra.Date < homNay);
                        <tr class="@(quaHan ? "table-danger" : "")">
                            <td class="fw-bold">#@pm.MaPhieuMuon</td>
                            <td>@pm.NgayMuon.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="@(quaHan ? "text-danger fw-bold" : "")">@pm.HanTra.ToString("dd/MM/yyyy")</span>
                                @if (quaHan)
                                {
                                    <div class="badge bg-danger mt-1">Quá hạn @((homNay - pm.HanTra.Date).Days) ngày</div>
                                }
                            </td>
                            <td>
                                @foreach (var ct in pm.ChiTietPhieuMuons)
                                {
                                    <div class="mb-1">
                                        &bull; <a asp-controller="Sach" asp-action="Details" asp-route-id="@ct.MaSach" class="text-dark text-decoration-none fw-semibold">
                                            @ct.Sach?.TenSach
                                        </a>
                                        <span class="text-muted">(Số lượng: @ct.SoLuongMuon cuốn)</span>
                                    </div>
                                }
                            </td>
                            <td class="text-center">
                                @if (pm.TrangThai == "Chờ xác nhận")
                                {
                                    <span class="badge bg-warning bg-opacity-25 text-dark">Chờ xác nhận</span>
                                }
                                else if (pm.TrangThai == "Đang mượn")
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary">Đang mượn</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="ChiTietPhieu" asp-route-id="@pm.MaPhieuMuon" class="btn btn-sm btn-outline-secondary">
                                    Chi tiết
                                </a>
                                @if (quaHan)
                                {
                                    <a asp-controller="ThanhToan" asp-action="Index" asp-route-maPhieuMuon="@pm.MaPhieuMuon" asp-route-loai="PhatQuaHan" class="btn btn-sm btn-danger mt-1 d-block fw-semibold">
                                        💳 Đóng phạt QR
                                    </a>
                                }
                                else if (pm.TrangThai == "Chờ xác nhận")
                                {
                                    <a asp-controller="ThanhToan" asp-action="Index" asp-route-maPhieuMuon="@pm.MaPhieuMuon" asp-route-loai="TienCoc" class="btn btn-sm btn-outline-success mt-1 d-block fw-semibold">
                                        💳 Nộp cọc QR
                                    </a>
                                    <form asp-action="HuyYeuCau" asp-route-id="@pm.MaPhieuMuon" method="post" class="d-inline mt-1">
                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0 small text-decoration-none" onclick="return confirm('Bạn có chắc muốn hủy yêu cầu mượn phiếu #@pm.MaPhieuMuon?');">
                                            Hủy phiếu
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
