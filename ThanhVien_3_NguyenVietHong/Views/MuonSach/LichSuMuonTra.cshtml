@model IEnumerable<QuanLyThuVien.Models.PhieuMuon>
@{
    ViewData["Title"] = "Lịch sử mượn trả tài liệu";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-1">Lịch Sử Mượn Trả Tài Liệu</h3>
        <small class="text-muted">Nhật ký toàn bộ các yêu cầu mượn sách, thời gian trả và trạng thái xử lý</small>
    </div>
    <a asp-action="DangKyMuon" class="btn btn-primary-custom fw-semibold">
        + Đăng Ký Mượn Mới
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <h5 class="fw-bold text-dark mb-2">Chưa có bản ghi lịch sử mượn trả</h5>
            <p class="text-muted small mb-0">Các phiếu mượn sau khi hoàn tất hoặc hủy sẽ được lưu trữ tại đây.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 80px;">Mã phiếu</th>
                        <th>Ngày mượn</th>
                        <th>Hạn trả</th>
                        <th>Các đầu sách &amp; Tình trạng hoàn trả</th>
                        <th class="text-center">Trạng thái phiếu</th>
                        <th class="text-center" style="width: 130px;">Chi tiết</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var pm in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@pm.MaPhieuMuon</td>
                            <td>@pm.NgayMuon.ToString("dd/MM/yyyy")</td>
                            <td>@pm.HanTra.ToString("dd/MM/yyyy")</td>
                            <td>
                                @foreach (var ct in pm.ChiTietPhieuMuons)
                                {
                                    <div class="mb-1">
                                        &bull; <a asp-controller="Sach" asp-action="Details" asp-route-id="@ct.MaSach" class="text-dark text-decoration-none fw-semibold">
                                            @ct.Sach?.TenSach
                                        </a>
                                        <span class="text-muted">(SL: @ct.SoLuongMuon)</span>
                                        @if (ct.NgayTra.HasValue)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success ms-1">
                                                Đã trả: @ct.NgayTra.Value.ToString("dd/MM/yyyy") - @ct.TinhTrangTra
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-dark ms-1">@ct.TinhTrangTra</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="text-center">
                                @if (pm.TrangThai == "Chờ xác nhận")
                                {
                                    <span class="badge bg-warning bg-opacity-25 text-dark">Chờ xác nhận</span>
                                }
                                else if (pm.TrangThai == "Đang mượn")
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary">Đang mượn</span>
                                }
                                else if (pm.TrangThai == "Đã trả")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Đã trả xong</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Đã hủy</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="ChiTietPhieu" asp-route-id="@pm.MaPhieuMuon" class="btn btn-sm btn-outline-secondary">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
