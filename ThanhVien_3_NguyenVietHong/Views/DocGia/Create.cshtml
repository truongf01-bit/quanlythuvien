@model QuanLyThuVien.Models.DocGia
@{
    ViewData["Title"] = "Thêm Độc giả mới";
}

<div class="card shadow-sm border-0 mx-auto" style="max-width: 750px;">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0 fw-bold">+ THÊM HỒ SƠ ĐỘC GIẢ &amp; TÀI KHOẢN MỚI</h5>
    </div>
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">1. Thông tin Tài khoản đăng nhập</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                    <input type="text" name="tenDangNhap" value="@ViewBag.TenDangNhap" class="form-control" placeholder="VD: docgia16" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                    <input type="text" name="matKhau" value="123456" class="form-control" required />
                </div>
            </div>

            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">2. Thông tin Hồ sơ Độc giả</h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="HoTen" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                    <input asp-for="HoTen" class="form-control" placeholder="Nhập họ và tên..." />
                    <span asp-validation-for="HoTen" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="NgaySinh" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                    <input asp-for="NgaySinh" type="date" class="form-control" />
                    <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="GioiTinh" class="form-label fw-semibold"></label>
                    <select asp-for="GioiTinh" class="form-select">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                    <input asp-for="SoDienThoai" class="form-control" placeholder="VD: 0912345678" />
                    <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                    <input asp-for="Email" class="form-control" placeholder="VD: docgia@sv.uneti.edu.vn" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-8">
                    <label asp-for="DiaChi" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                    <input asp-for="DiaChi" class="form-control" placeholder="Nhập địa chỉ liên hệ..." />
                    <span asp-validation-for="DiaChi" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="TrangThai" class="form-label fw-semibold"></label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="Hoạt động">Hoạt động</option>
                        <option value="Bị khóa">Bị khóa</option>
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary fw-bold px-4">Lưu độc giả</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy / Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
