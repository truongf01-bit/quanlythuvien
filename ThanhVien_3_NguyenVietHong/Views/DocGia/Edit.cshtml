@model QuanLyThuVien.Models.DocGia
@{
    ViewData["Title"] = "Cập nhật Độc giả";
}

<div class="card shadow-sm border-0 mx-auto" style="max-width: 750px;">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0 fw-bold">✏️ CẬP NHẬT HỒ SƠ ĐỘC GIẢ (#@Model.MaDocGia)</h5>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MaDocGia" />
            <input type="hidden" asp-for="MaTaiKhoan" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="HoTen" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                    <input asp-for="HoTen" class="form-control" />
                    <span asp-validation-for="HoTen" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="NgaySinh" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                    <input asp-for="NgaySinh" type="date" class="form-control" />
                    <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="GioiTinh" class="form-label fw-semibold"></label>
                    <select asp-for="GioiTinh" class="form-select">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                    <input asp-for="SoDienThoai" class="form-control" />
                    <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="DiaChi" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                    <input asp-for="DiaChi" class="form-control" />
                    <span asp-validation-for="DiaChi" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NgayDangKy" class="form-label fw-semibold"></label>
                    <input asp-for="NgayDangKy" type="date" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="TrangThai" class="form-label fw-semibold"></label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="Hoạt động">Hoạt động</option>
                        <option value="Bị khóa">Bị khóa</option>
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-warning fw-bold px-4">Lưu cập nhật</button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
