@model QuanLyThuVien.ViewModels.ThongKeViewModel
@{
    ViewData["Title"] = "Báo cáo Thống kê Thư viện";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-dark mb-1">Báo Cáo Thống Kê &amp; Phân Tích Dữ Liệu</h3>
        <small class="text-muted">Tổng hợp và kết xuất dữ liệu quản trị lưu thông thư viện (sử dụng LINQ GroupBy, Count, Sum, OrderBy)</small>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary">
        &larr; Về Dashboard
    </a>
</div>

<div class="row g-4">

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-dark">Phân Bố Tài Liệu Theo Thể Loại</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0 align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th>Thể loại</th>
                                <th class="text-center">Số đầu sách</th>
                                <th class="text-center">Tổng số cuốn</th>
                                <th class="text-center">Còn trên kệ</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var item in Model.SachTheoTheLoai)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.TenTheLoai</td>
                                    <td class="text-center"><span class="badge bg-secondary bg-opacity-10 text-secondary">@item.SoDauSach</span></td>
                                    <td class="text-center">@item.TongSoBanSach</td>
                                    <td class="text-center text-success fw-bold">@item.TongSoSachCon</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-dark">Trạng Thái Lưu Thông Phiếu Mượn</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0 align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th>Trạng thái phiếu mượn</th>
                                <th class="text-center">Số lượng phiếu</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var item in Model.PhieuTheoTrangThai)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @if (item.TrangThai == "Chờ xác nhận")
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-dark me-1">Chờ xác nhận</span>
                                        }
                                        else if (item.TrangThai == "Đang mượn")
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary me-1">Đang mượn</span>
                                        }
                                        else if (item.TrangThai == "Đã trả")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success me-1">Đã trả</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary me-1">Đã hủy</span>
                                        }
                                        @item.TrangThai
                                    </td>
                                    <td class="text-center fw-bold text-dark">@item.SoLuongPhieu phiếu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-primary">Top 5 Tài Liệu Được Mượn Nhiều Nhất</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0 align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th style="width: 45px;">Hạng</th>
                                <th>Tên đầu sách &amp; Tác giả</th>
                                <th class="text-center">Số lượt phiếu</th>
                                <th class="text-center">Tổng cuốn mượn</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @{ int rank = 1; }
                            @foreach (var item in Model.SachMuonNhieuNhat)
                            {
                                <tr>
                                    <td class="text-center fw-bold">
                                        @if (rank == 1) { <span class="badge bg-warning text-dark">1</span> }
                                        else if (rank == 2) { <span class="badge bg-secondary text-white">2</span> }
                                        else if (rank == 3) { <span class="badge bg-danger bg-opacity-75 text-white">3</span> }
                                        else { <span>@(rank)</span> }
                                        @{ rank++; }
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.TenSach</div>
                                        <small class="text-muted">@item.TacGia</small>
                                    </td>
                                    <td class="text-center">@item.SoLuotPhieuMuon lượt</td>
                                    <td class="text-center"><span class="badge bg-success bg-opacity-10 text-success fw-bold">@item.TongSoCuonDuocMuon cuốn</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-dark">Lưu Lượng Mượn Sách Theo Từng Tháng</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0 align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th>Tháng / Năm</th>
                                <th class="text-center">Số phiếu mượn phát sinh</th>
                                <th class="text-center">Tổng số cuốn tài liệu</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var item in Model.PhieuMuonTheoThang)
                            {
                                <tr>
                                    <td class="fw-semibold">Tháng @item.Thang.ToString("00")/@item.Nam</td>
                                    <td class="text-center fw-bold">@item.SoPhieuMuon phiếu</td>
                                    <td class="text-center text-primary fw-bold">@item.TongSoSachMuon cuốn</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-dark">Chi Tiết Lượt Mượn Theo Từng Đầu Sách</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 320px;">
                    <table class="table table-bordered table-hover table-sm mb-0 align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th style="width: 50px;">Mã</th>
                                <th>Tên đầu sách</th>
                                <th class="text-center">Lượt mượn</th>
                                <th class="text-center">Tổng cuốn</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var item in Model.LuotMuonTheoSach)
                            {
                                <tr>
                                    <td>#@item.MaSach</td>
                                    <td class="fw-semibold">@item.TenSach</td>
                                    <td class="text-center">@item.SoLuotPhieuMuon</td>
                                    <td class="text-center fw-bold text-primary">@item.TongSoCuonDuocMuon</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-dark">Thống Kê Tần Suất Mượn Theo Độc Giả</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 320px;">
                    <table class="table table-bordered table-hover table-sm mb-0 align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th style="width: 65px;">Mã ĐG</th>
                                <th>Họ và tên độc giả</th>
                                <th>Điện thoại</th>
                                <th class="text-center">Số phiếu</th>
                                <th class="text-center">Tổng cuốn</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var item in Model.LuotMuonTheoDocGia)
                            {
                                <tr>
                                    <td>#@item.MaDocGia</td>
                                    <td class="fw-semibold">@item.HoTen</td>
                                    <td>@item.SoDienThoai</td>
                                    <td class="text-center fw-bold">@item.SoPhieuMuon</td>
                                    <td class="text-center text-success fw-bold">@item.TongSachDaMuon</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Thống kê Tài chính & Quản trị Dòng tiền (Nguồn vào / Nguồn ra) -->
    <div class="col-12 mt-4">
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-cash-stack text-success me-2"></i>Báo Cáo Quản Trị Dòng Tiền (Nguồn Vào / Nguồn Ra)</h6>
                    <small class="text-muted">Theo dõi lưu thông tiền cọc, hoàn cọc, phí phạt và bồi thường theo phiếu mượn</small>
                </div>
                <a asp-controller="ThanhToan" asp-action="LichSu" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-journal-text me-1"></i>Xem Sổ Giao Dịch Chi Tiết
                </a>
            </div>
            <div class="card-body p-3">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-semibold text-success"><i class="bi bi-arrow-down-circle me-1"></i>TỔNG NGUỒN VÀO (THU)</span>
                                <span class="badge bg-success">Cọc &amp; Phạt</span>
                            </div>
                            <div class="fs-4 fw-bold text-success">@Model.TongNguonVao.ToString("N0") <small class="fs-6">VNĐ</small></div>
                            <small class="text-muted">Tiền cọc mượn sách, thu phạt quá hạn, bồi thường</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-danger bg-opacity-10 border border-danger border-opacity-25">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-semibold text-danger"><i class="bi bi-arrow-up-circle me-1"></i>TỔNG NGUỒN RA (CHI / HOÀN)</span>
                                <span class="badge bg-danger">Hoàn cọc</span>
                            </div>
                            <div class="fs-4 fw-bold text-danger">@Model.TongNguonRa.ToString("N0") <small class="fs-6">VNĐ</small></div>
                            <small class="text-muted">Hoàn tiền cọc khi trả sách hoặc hoàn tiền hủy phiếu</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-primary bg-opacity-10 border border-primary border-opacity-25">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-semibold text-primary"><i class="bi bi-wallet2 me-1"></i>TỒN QUỸ LƯU THÔNG</span>
                                <span class="badge bg-primary">Net Cash</span>
                            </div>
                            <div class="fs-4 fw-bold text-primary">@Model.TinhTonQuyTien.ToString("N0") <small class="fs-6">VNĐ</small></div>
                            <small class="text-muted">Chênh lệch dòng tiền đang lưu giữ tại quỹ thư viện</small>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0 align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th>Mục đích thanh toán</th>
                                <th class="text-center">Hướng dòng tiền</th>
                                <th class="text-center">Số giao dịch</th>
                                <th class="text-end">Tổng số tiền</th>
                                <th class="text-center">Tỷ trọng</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @if (Model.DongTienTheoMucDich != null && Model.DongTienTheoMucDich.Any())
                            {
                                foreach (var item in Model.DongTienTheoMucDich)
                                {
                                    var isVao = item.HuongDongTien == "Nguồn vào";
                                    var tongHuong = isVao ? Model.TongNguonVao : Model.TongNguonRa;
                                    var tyTrong = tongHuong > 0 ? (item.TongTien / tongHuong * 100) : 0;
                                    <tr>
                                        <td class="fw-semibold">
                                            @if (item.LoaiThanhToan.Contains("cọc"))
                                            {
                                                <i class="bi bi-shield-check text-primary me-1"></i>
                                            }
                                            else if (item.LoaiThanhToan.Contains("phạt"))
                                            {
                                                <i class="bi bi-exclamation-triangle text-warning me-1"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-cash me-1"></i>
                                            }
                                            @item.LoaiThanhToan
                                        </td>
                                        <td class="text-center">
                                            @if (isVao)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                                    📥 Nguồn vào
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">
                                                    💸 Nguồn ra
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center fw-bold">@item.SoGiaoDich</td>
                                        <td class="text-end fw-bold @(isVao ? "text-success" : "text-danger")">
                                            @(isVao ? "+" : "-")@item.TongTien.ToString("N0") VNĐ
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex align-items-center justify-content-center gap-2">
                                                <div class="progress flex-grow-1" style="height: 6px; max-width: 80px;">
                                                    <div class="progress-bar @(isVao ? "bg-success" : "bg-danger")" style="width: @tyTrong.ToString("F0")%"></div>
                                                </div>
                                                <span class="text-muted small">@tyTrong.ToString("F1")%</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">Chưa có dữ liệu giao dịch dòng tiền</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
