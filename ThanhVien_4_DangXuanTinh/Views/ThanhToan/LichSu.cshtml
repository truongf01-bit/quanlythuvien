@model IEnumerable<QuanLyThuVien.Models.GiaoDichThanhToan>
@{
    ViewData["Title"] = "Sổ Giao Dịch Dòng Tiền (Nguồn Vào / Nguồn Ra)";
    bool laAdmin = ViewBag.LaAdmin == true;
}

<div class="container-fluid py-3">

    <!-- Header & Action -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                📊 Sổ Giao Dịch Dòng Tiền &amp; Thu Chi Phiếu Mượn
            </h4>
            <p class="text-muted small mb-0">
                Theo dõi minh bạch toàn bộ Nguồn vào (Thu cọc, Phạt, Bồi thường) và Nguồn ra (Hoàn cọc, Chi hoàn)
            </p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-sm-0">
            <a asp-action="Index" asp-route-huong="NguonVao" class="btn btn-success fw-semibold btn-sm">
                ➕ Lập Giao Dịch Nguồn Vào (Thu)
            </a>
            <a asp-action="Index" asp-route-huong="NguonRa" class="btn btn-danger fw-semibold btn-sm">
                ➖ Lập Giao Dịch Nguồn Ra (Hoàn/Chi)
            </a>
        </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="row g-3 mb-4">
        <!-- Tổng Nguồn Vào -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-success border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">📥 Tổng Dòng Tiền Vào (Thu)</div>
                            <h4 class="fw-bold text-success mb-0 mt-1">@ViewBag.TongNguonVao.ToString("N0") đ</h4>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 fs-4">
                            📈
                        </div>
                    </div>
                    <small class="text-muted mt-2 d-block">Tiền cọc mượn sách, phạt quá hạn, bồi thường</small>
                </div>
            </div>
        </div>

        <!-- Tổng Nguồn Ra -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-danger border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">📤 Tổng Dòng Tiền Ra (Chi/Hoàn)</div>
                            <h4 class="fw-bold text-danger mb-0 mt-1">@ViewBag.TongNguonRa.ToString("N0") đ</h4>
                        </div>
                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 fs-4">
                            📉
                        </div>
                    </div>
                    <small class="text-muted mt-2 d-block">Hoàn trả cọc khi trả sách, hoàn hủy phiếu</small>
                </div>
            </div>
        </div>

        <!-- Tồn Quỹ Ròng -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">💰 Tồn Quỹ Cọc &amp; Doanh Thu</div>
                            <h4 class="fw-bold text-primary mb-0 mt-1">@ViewBag.ChenhLechQuy.ToString("N0") đ</h4>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 fs-4">
                            🏦
                        </div>
                    </div>
                    <small class="text-muted mt-2 d-block">Chênh lệch dòng tiền hiện có (Vào - Ra)</small>
                </div>
            </div>
        </div>

        <!-- Chờ đối soát -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-warning border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">⏳ Chờ Đối Soát / Kiểm Tra</div>
                            <h4 class="fw-bold text-warning mb-0 mt-1">@ViewBag.SoChoDoiSoat giao dịch</h4>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 fs-4">
                            ⏱️
                        </div>
                    </div>
                    <small class="text-muted mt-2 d-block">Giao dịch quét mã QR cần thủ thư xác nhận</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Thanh Lọc & Tìm Kiếm -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="LichSu" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Từ khóa tìm kiếm</label>
                    <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control form-control-sm" placeholder="Mã GD, tên SV, nội dung, nguồn..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Hướng dòng tiền</label>
                    <select name="huongDongTien" class="form-select form-select-sm">
                        <option value="">-- Tất cả hướng --</option>
                        <option value="Nguồn vào" selected="@(ViewBag.HuongDongTien == "Nguồn vào")">📥 Nguồn vào (Thu)</option>
                        <option value="Nguồn ra" selected="@(ViewBag.HuongDongTien == "Nguồn ra")">📤 Nguồn ra (Chi/Hoàn)</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Loại thanh toán</label>
                    <select name="loaiThanhToan" class="form-select form-select-sm">
                        <option value="">-- Tất cả loại --</option>
                        <option value="cọc" selected="@(ViewBag.LoaiThanhToan == "cọc")">Tiền cọc mượn sách</option>
                        <option value="Hoàn" selected="@(ViewBag.LoaiThanhToan == "Hoàn")">Hoàn trả tiền cọc</option>
                        <option value="phạt" selected="@(ViewBag.LoaiThanhToan == "phạt")">Phạt quá hạn</option>
                        <option value="thường" selected="@(ViewBag.LoaiThanhToan == "thường")">Bồi thường sách</option>
                        <option value="thẻ" selected="@(ViewBag.LoaiThanhToan == "thẻ")">Phí làm thẻ</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Mã phiếu mượn</label>
                    <input type="number" name="maPhieuMuon" value="@ViewBag.MaPhieuMuon" class="form-control form-control-sm" placeholder="VD: 1, 2..." />
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm fw-semibold flex-grow-1">
                        🔍 Lọc dữ liệu
                    </button>
                    <a asp-action="LichSu" class="btn btn-outline-secondary btn-sm">
                        ↺ Xóa lọc
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng Danh Sách Giao Dịch Dòng Tiền -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                Danh Sách Giao Dịch Dòng Tiền (@Model.Count() bản ghi)
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th style="width: 130px;">Mã GD / Ngày</th>
                        <th>Phiếu mượn</th>
                        <th>Người thực hiện</th>
                        <th>Hướng dòng tiền</th>
                        <th>Mục đích thanh toán</th>
                        <th style="min-width: 170px;">💸 Nguồn ra của tiền</th>
                        <th style="min-width: 170px;">📥 Nguồn vào của tiền</th>
                        <th class="text-end">Số tiền</th>
                        <th>Phương thức</th>
                        <th>Trạng thái</th>
                        @if (laAdmin)
                        {
                            <th class="text-center" style="width: 100px;">Thao tác</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center py-4 text-muted">
                                Không tìm thấy giao dịch dòng tiền nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    @foreach (var gd in Model)
                    {
                        bool isRa = gd.HuongDongTien == "Nguồn ra";
                        <tr>
                            <td>
                                <strong class="text-primary font-monospace">@gd.MaGiaoDichCode</strong>
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    @gd.NgayGiaoDich.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </td>

                            <td>
                                @if (gd.MaPhieuMuon.HasValue)
                                {
                                    <a asp-controller="PhieuMuon" asp-action="Details" asp-route-id="@gd.MaPhieuMuon.Value" class="badge bg-light text-primary border text-decoration-none">
                                        #@gd.MaPhieuMuon.Value
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">--</span>
                                }
                            </td>

                            <td>
                                <strong class="text-dark">@gd.NguoiThucHien</strong>
                                @if (!string.IsNullOrEmpty(gd.SoDienThoai))
                                {
                                    <div class="text-muted" style="font-size: 0.75rem;">@gd.SoDienThoai</div>
                                }
                            </td>

                            <td>
                                @if (isRa)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">
                                        📤 Nguồn ra (Chi)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                        📥 Nguồn vào (Thu)
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="fw-semibold text-secondary">@gd.LoaiThanhToan</span>
                            </td>

                            <td>
                                <div class="text-danger small fw-semibold">
                                    <span class="badge bg-danger bg-opacity-10 text-danger p-1">Ra</span> @gd.NguonTienRa
                                </div>
                            </td>

                            <td>
                                <div class="text-success small fw-semibold">
                                    <span class="badge bg-success bg-opacity-10 text-success p-1">Vào</span> @gd.NguonTienVao
                                </div>
                            </td>

                            <td class="text-end">
                                <strong class="@(isRa ? "text-danger" : "text-success") fs-6 font-monospace">
                                    @(isRa ? "-" : "+")@gd.SoTien.ToString("N0") đ
                                </strong>
                            </td>

                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-dark">
                                    @gd.PhuongThuc
                                </span>
                            </td>

                            <td>
                                @if (gd.TrangThai == "Đã hoàn thành")
                                {
                                    <span class="badge bg-success">Đã hoàn thành</span>
                                }
                                else if (gd.TrangThai == "Chờ đối soát")
                                {
                                    <span class="badge bg-warning text-dark">Chờ đối soát</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@gd.TrangThai</span>
                                }
                            </td>

                            @if (laAdmin)
                            {
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <a asp-action="ChiTiet" asp-route-id="@gd.MaGiaoDich" class="btn btn-xs btn-outline-info py-0 px-2" title="Xem biên lai điện tử">
                                            📄
                                        </a>
                                        @if (gd.TrangThai == "Chờ đối soát")
                                        {
                                            <form asp-action="XacNhanDoiSoat" asp-route-id="@gd.MaGiaoDich" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-xs btn-success py-0 px-2" title="Duyệt đối soát" onclick="return confirm('Xác nhận đã kiểm tra đối soát giao dịch @gd.MaGiaoDichCode?');">
                                                    ✓
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
