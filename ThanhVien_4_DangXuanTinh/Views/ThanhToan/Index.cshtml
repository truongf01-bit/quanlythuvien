@model QuanLyThuVien.ViewModels.ThanhToanViewModel
@{
    ViewData["Title"] = "Thanh Toán & Quản Lý Dòng Tiền (Nguồn Vào / Nguồn Ra)";
    bool laNguonRa = Model.HuongDongTien == "Nguồn ra";
}

<div class="container py-3">

    <!-- Header & Breadcrumb -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <span class="badge @(laNguonRa ? "bg-danger" : "bg-primary") bg-opacity-10 @(laNguonRa ? "text-danger" : "text-primary") px-3 py-2 rounded-pill fw-semibold mb-1">
                @(laNguonRa ? "DÒNG TIỀN CHI / HOÀN TIỀN" : "DÒNG TIỀN THU / NỘP TIỀN") - THƯ VIỆN ĐẠI HỌC UNETI
            </span>
            <h3 class="fw-bold text-dark mb-0">Cổng Thanh Toán &amp; Quản Lý Dòng Tiền Phiếu Mượn</h3>
        </div>
        <div class="mt-2 mt-sm-0">
            <a asp-action="LichSu" class="btn btn-outline-primary fw-semibold btn-sm">
                📋 Xem Sổ Giao Dịch Dòng Tiền
            </a>
        </div>
    </div>

    <!-- Alert thông báo liên kết phiếu mượn nếu có -->
    @if (Model.MaPhieuMuon.HasValue)
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between py-2 px-3 small mb-3 border-warning border-opacity-50">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">📌</span>
                <div>
                    <strong>Phiếu mượn liên kết: #@Model.MaPhieuMuon.Value</strong>
                    <span class="ms-2 text-muted">Hệ thống sẽ cập nhật và gắn chứng từ dòng tiền này vào hồ sơ phiếu mượn.</span>
                </div>
            </div>
            <a asp-controller="PhieuMuon" asp-action="Details" asp-route-id="@Model.MaPhieuMuon.Value" class="btn btn-xs btn-outline-dark py-1 px-2 text-decoration-none">
                Xem chi tiết phiếu
            </a>
        </div>
    }

    <!-- Tab Chọn Hướng Dòng Tiền: Nguồn Vào vs Nguồn Ra -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-2">
                <div class="col-md-6">
                    <button type="button" class="btn w-100 py-3 text-start border-2 @(!laNguonRa ? "btn-primary border-primary shadow-sm" : "btn-outline-secondary border-light-subtle")" onclick="chuyenHuongDongTien('NguonVao')">
                        <div class="d-flex align-items-center gap-3">
                            <span class="fs-2">📥</span>
                            <div>
                                <div class="fw-bold fs-6">NGUỒN VÀO (Thu tiền vào Thư viện)</div>
                                <small class="@(!laNguonRa ? "text-white-50" : "text-muted")">
                                    Nộp tiền cọc mượn sách, nộp phạt trễ hạn, bồi thường mất/hỏng sách, làm thẻ
                                </small>
                            </div>
                        </div>
                    </button>
                </div>
                <div class="col-md-6">
                    <button type="button" class="btn w-100 py-3 text-start border-2 @(laNguonRa ? "btn-danger border-danger shadow-sm text-white" : "btn-outline-secondary border-light-subtle")" onclick="chuyenHuongDongTien('NguonRa')">
                        <div class="d-flex align-items-center gap-3">
                            <span class="fs-2">📤</span>
                            <div>
                                <div class="fw-bold fs-6">NGUỒN RA (Chi / Hoàn tiền từ Thư viện)</div>
                                <small class="@(laNguonRa ? "text-white-50" : "text-muted")">
                                    Hoàn trả tiền cọc khi độc giả trả sách, hoàn cọc do hủy phiếu, chi hoàn trả
                                </small>
                            </div>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="XacNhan" method="post" id="formThanhToan">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaPhieuMuon" />
        <input type="hidden" asp-for="MaDocGia" />
        <input type="hidden" asp-for="HuongDongTien" id="inputHuongDongTien" value="@Model.HuongDongTien" />

        <div class="row g-4 justify-content-center">

            <!-- Cột trái: Form thông tin chi tiết -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                            <span>📝</span> Thiết lập Thông tin Dòng Tiền &amp; Giao dịch
                        </h6>
                        <span class="badge @(laNguonRa ? "bg-danger" : "bg-primary")" id="badgeHuong">
                            @Model.HuongDongTien
                        </span>
                    </div>

                    <div class="card-body p-4">

                        <!-- Khối trực quan: NGUỒN RA CỦA TIỀN -> NGUỒN VÀO CỦA TIỀN -->
                        <div class="p-3 bg-light rounded-4 border mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold small text-secondary text-uppercase tracking-wider">
                                    🔄 Sơ đồ dòng luân chuyển của tiền
                                </span>
                                <span class="badge bg-secondary bg-opacity-25 text-dark small">Dòng tiền minh bạch</span>
                            </div>

                            <div class="row g-2 align-items-center">
                                <!-- Nguồn Ra -->
                                <div class="col-md-5">
                                    <div class="p-2 border rounded-3 bg-white shadow-sm text-center">
                                        <div class="small fw-bold text-danger mb-1">
                                            💸 NGUỒN RA CỦA TIỀN (Trích từ)
                                        </div>
                                        <div class="small fw-semibold text-dark text-truncate" id="displayNguonRa">
                                            @Model.NguonTienRa
                                        </div>
                                    </div>
                                </div>

                                <!-- Mũi tên chuyển -->
                                <div class="col-md-2 text-center text-primary fs-4 fw-bold">
                                    ➔
                                </div>

                                <!-- Nguồn Vào -->
                                <div class="col-md-5">
                                    <div class="p-2 border rounded-3 bg-white shadow-sm text-center">
                                        <div class="small fw-bold text-success mb-1">
                                            📥 NGUỒN VÀO CỦA TIỀN (Nhận vào)
                                        </div>
                                        <div class="small fw-semibold text-dark text-truncate" id="displayNguonVao">
                                            @Model.NguonTienVao
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Cấu hình Nguồn Ra & Nguồn Vào -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-danger">
                                    💸 Nguồn ra của tiền (Tiền trích từ) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-danger bg-opacity-10 text-danger border-end-0">📤</span>
                                    <input asp-for="NguonTienRa" id="inputNguonTienRa" class="form-control form-control-sm border-start-0" list="danhSachNguonRa" required oninput="capNhatSoDo()" />
                                </div>
                                <datalist id="danhSachNguonRa">
                                    <option value="Tài khoản cá nhân độc giả (Chuyển khoản QR)" />
                                    <option value="Tiền mặt độc giả nộp tại quầy" />
                                    <option value="Ví MoMo của độc giả" />
                                    <option value="Tài khoản MB Bank của độc giả" />
                                    <option value="Quỹ tiền mặt quầy thủ thư" />
                                    <option value="Tài khoản MB Bank thư viện (21611611116 - NGUYEN XUAN TRUONG)" />
                                    <option value="Ví MoMo thư viện (09******498)" />
                                </datalist>
                                <span asp-validation-for="NguonTienRa" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-success">
                                    📥 Nguồn vào của tiền (Tiền nhận vào) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-success bg-opacity-10 text-success border-end-0">📥</span>
                                    <input asp-for="NguonTienVao" id="inputNguonTienVao" class="form-control form-control-sm border-start-0" list="danhSachNguonVao" required oninput="capNhatSoDo()" />
                                </div>
                                <datalist id="danhSachNguonVao">
                                    <option value="Tài khoản MB Bank thư viện (21611611116 - NGUYEN XUAN TRUONG)" />
                                    <option value="Quỹ tiền mặt quầy thủ thư" />
                                    <option value="Ví MoMo thư viện (09******498)" />
                                    <option value="Tiền mặt độc giả nhận tại quầy" />
                                    <option value="Tài khoản ngân hàng của độc giả / sinh viên" />
                                    <option value="Ví MoMo của độc giả" />
                                </datalist>
                                <span asp-validation-for="NguonTienVao" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Mục đích thanh toán -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Mục đích thanh toán / Loại giao dịch</label>
                            
                            <!-- Nhóm mục đích NGUỒN VÀO (Thu) -->
                            <div class="row g-2" id="groupMucDichNguonVao" style="@(laNguonRa ? "display:none;" : "")">
                                <div class="col-6 col-sm-3">
                                    <div class="p-2 border rounded-3 bg-light fee-option cursor-pointer text-center" onclick="chonLoaiPhi('TienCoc', 100000)">
                                        <input class="form-check-input" type="radio" asp-for="LoaiThanhToan" value="TienCoc" id="optTienCoc">
                                        <label class="form-check-label d-block small fw-semibold mt-1" for="optTienCoc">
                                            📚 Cọc sách<br><span class="text-primary small">100.000đ</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <div class="p-2 border rounded-3 bg-light fee-option cursor-pointer text-center" onclick="chonLoaiPhi('PhatQuaHan', 20000)">
                                        <input class="form-check-input" type="radio" asp-for="LoaiThanhToan" value="PhatQuaHan" id="optPhatQuaHan">
                                        <label class="form-check-label d-block small fw-semibold mt-1" for="optPhatQuaHan">
                                            ⚠️ Phạt trễ<br><span class="text-danger small">20.000đ</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <div class="p-2 border rounded-3 bg-light fee-option cursor-pointer text-center" onclick="chonLoaiPhi('BoiThuong', 150000)">
                                        <input class="form-check-input" type="radio" asp-for="LoaiThanhToan" value="BoiThuong" id="optBoiThuong">
                                        <label class="form-check-label d-block small fw-semibold mt-1" for="optBoiThuong">
                                            🛠️ Bồi thường<br><span class="text-warning text-dark small">150.000đ</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <div class="p-2 border rounded-3 bg-light fee-option cursor-pointer text-center" onclick="chonLoaiPhi('PhiThe', 50000)">
                                        <input class="form-check-input" type="radio" asp-for="LoaiThanhToan" value="PhiThe" id="optPhiThe">
                                        <label class="form-check-label d-block small fw-semibold mt-1" for="optPhiThe">
                                            🎫 Thẻ ĐG<br><span class="text-secondary small">50.000đ</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Nhóm mục đích NGUỒN RA (Chi/Hoàn) -->
                            <div class="row g-2" id="groupMucDichNguonRa" style="@(!laNguonRa ? "display:none;" : "")">
                                <div class="col-6">
                                    <div class="p-2 border rounded-3 bg-light fee-option cursor-pointer text-center border-danger" onclick="chonLoaiPhi('HoanCoc', 100000)">
                                        <input class="form-check-input" type="radio" asp-for="LoaiThanhToan" value="HoanCoc" id="optHoanCoc">
                                        <label class="form-check-label d-block small fw-semibold mt-1 text-danger" for="optHoanCoc">
                                            ↩️ Hoàn trả tiền cọc mượn sách (100.000đ)
                                        </label>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 border rounded-3 bg-light fee-option cursor-pointer text-center" onclick="chonLoaiPhi('Khac', 0)">
                                        <input class="form-check-input" type="radio" asp-for="LoaiThanhToan" value="Khac" id="optKhacRa">
                                        <label class="form-check-label d-block small fw-semibold mt-1" for="optKhacRa">
                                            💵 Chi hoàn tiền tùy chỉnh / Khác
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Số tiền -->
                        <div class="mb-3">
                            <label asp-for="SoTien" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <input asp-for="SoTien" id="inputSoTien" type="number" step="1000" class="form-control form-control-lg fw-bold @(laNguonRa ? "text-danger" : "text-primary")" required onchange="capNhatGiaTri()" />
                                <span class="input-group-text fw-bold text-muted">VNĐ</span>
                            </div>
                            <span asp-validation-for="SoTien" class="text-danger small"></span>
                        </div>

                        <!-- Phương thức thanh toán -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Phương thức thực hiện</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="PhuongThuc" value="MBBank" id="ptMB" checked onchange="doiPhuongThuc('MBBank')">
                                    <label class="form-check-label small fw-semibold" for="ptMB">
                                        🏦 Chuyển khoản QR (MB Bank)
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="PhuongThuc" value="MoMo" id="ptMoMo" onchange="doiPhuongThuc('MoMo')">
                                    <label class="form-check-label small fw-semibold" for="ptMoMo">
                                        📱 Ví MoMo
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="PhuongThuc" value="TienMat" id="ptTienMat" onchange="doiPhuongThuc('TienMat')">
                                    <label class="form-check-label small fw-semibold" for="ptTienMat">
                                        💵 Tiền mặt tại quầy
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Thông tin người nộp / nhận -->
                        <div class="row g-2 mb-3">
                            <div class="col-md-7">
                                <label asp-for="HoTen" class="form-label small fw-semibold text-secondary"></label>
                                <input asp-for="HoTen" id="inputHoTen" class="form-control form-control-sm" placeholder="Họ và tên độc giả / sinh viên..." required oninput="capNhatGiaTri()" />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="SoDienThoai" class="form-label small fw-semibold text-secondary"></label>
                                <input asp-for="SoDienThoai" class="form-control form-control-sm" placeholder="09xxxx..." />
                            </div>
                        </div>

                        <!-- Thông tin tài khoản độc giả (khi hoàn cọc chuyển khoản) -->
                        <div class="mb-3" id="groupTaiKhoanDoiUng" style="@(laNguonRa ? "" : "display:none;")">
                            <label class="form-label small fw-semibold text-danger">
                                💳 STK &amp; Ngân hàng của Độc giả nhận hoàn cọc (nếu chuyển khoản)
                            </label>
                            <input asp-for="ThongTinTaiKhoanDoiUng" class="form-control form-control-sm" placeholder="VD: 1029384756 - Vietcombank (Nguyễn Văn A)" />
                            <small class="text-muted" style="font-size: 0.75rem;">
                                * Nếu hoàn tiền mặt tại quầy, có thể để trống trường này.
                            </small>
                        </div>

                        <!-- Cú pháp chuyển khoản -->
                        <div class="mb-4 p-3 @(laNguonRa ? "bg-danger bg-opacity-10 border border-danger border-opacity-25" : "bg-primary bg-opacity-10 border border-primary border-opacity-25") rounded-3">
                            <label class="form-label small fw-bold @(laNguonRa ? "text-danger" : "text-primary") mb-1">
                                💬 Nội dung chuyển khoản / Ghi chú chứng từ:
                            </label>
                            <div class="d-flex align-items-center justify-content-between gap-2 mt-1">
                                <input asp-for="NoiDungChuyenKhoan" id="inputNoiDung" class="form-control fw-bold font-monospace bg-white text-danger border-0" />
                                <button type="button" class="btn btn-outline-primary btn-sm flex-shrink-0" onclick="copyNoiDung()">
                                    📋 Sao chép
                                </button>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn @(laNguonRa ? "btn-danger" : "btn-success") btn-lg fs-6 py-2 fw-bold" id="btnSubmit">
                                @(laNguonRa ? "📤 Xác Nhận Xuất Chi / Hoàn Tiền" : "✅ Tôi Đã Chuyển Khoản / Nộp Tiền Thành Công")
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Hướng dẫn QR hoặc Biên lai chi tiền -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white py-2 border-bottom">
                        <ul class="nav nav-pills nav-fill" id="qrTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-bold py-2 d-flex align-items-center justify-content-center gap-2" id="mbbank-tab" data-bs-toggle="pill" data-bs-target="#tabMBBank" type="button" role="tab">
                                    <span class="badge bg-danger rounded-circle p-1">★</span> MB Bank (VietQR)
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold py-2 d-flex align-items-center justify-content-center gap-2" id="momo-tab" data-bs-toggle="pill" data-bs-target="#tabMoMo" type="button" role="tab" style="color: #a50064;">
                                    <span class="fw-bold">M</span> Ví MoMo
                                </button>
                            </li>
                        </ul>
                    </div>

                    <div class="card-body p-4 text-center">
                        <div class="tab-content" id="qrTabsContent">

                            <!-- Tab MB Bank -->
                            <div class="tab-pane fade show active" id="tabMBBank" role="tabpanel">
                                <div class="p-2 bg-light rounded-4 border d-inline-block shadow-sm mb-3">
                                    <img src="~/images/payments/qr-mbbank.png" alt="QR Code MB Bank" class="img-fluid rounded-3" style="max-height: 340px; width: auto;" />
                                </div>

                                <div class="bg-light p-3 rounded-3 text-start small border">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-secondary">Tài khoản thụ hưởng:</span>
                                        <strong class="text-dark">MB Bank (Quân Đội)</strong>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-secondary">Số tài khoản:</span>
                                        <div class="d-flex align-items-center gap-1">
                                            <code class="fs-6 text-primary fw-bold">21611611116</code>
                                            <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="copyText('21611611116', 'Đã sao chép STK MB Bank!')">Copy</button>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-secondary">Chủ tài khoản:</span>
                                        <strong class="text-uppercase text-dark">NGUYEN XUAN TRUONG</strong>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-secondary">Số tiền:</span>
                                        <strong class="text-danger fs-6 display-amount">100,000 đ</strong>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab MoMo -->
                            <div class="tab-pane fade" id="tabMoMo" role="tabpanel">
                                <div class="p-2 bg-light rounded-4 border d-inline-block shadow-sm mb-3">
                                    <img src="~/images/payments/qr-momo.png" alt="QR Code MoMo" class="img-fluid rounded-3" style="max-height: 340px; width: auto;" />
                                </div>

                                <div class="bg-light p-3 rounded-3 text-start small border">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-secondary">Ứng dụng:</span>
                                        <strong style="color: #a50064;">Ví Điện Tử MoMo / VietQR</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-secondary">Chủ tài khoản:</span>
                                        <strong class="text-dark">Nguyễn Xuân Trường</strong>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-secondary">Số điện thoại:</span>
                                        <span class="badge bg-secondary">*******498</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-secondary">Số tiền:</span>
                                        <strong class="text-danger fs-6 display-amount">100,000 đ</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card lưu ý nghiệp vụ nguồn vào / nguồn ra -->
                        <div class="alert alert-info py-2 px-3 small mt-3 mb-0 text-start border-info border-opacity-50">
                            <strong>💡 Quy tắc Dòng Tiền Thư Viện:</strong>
                            <ul class="mb-0 ps-3 mt-1 small">
                                <li><strong>Nguồn vào:</strong> Độc giả thanh toán cọc/phạt $\rightarrow$ Tiền vào Quỹ hoặc TK MB Thư viện.</li>
                                <li><strong>Nguồn ra:</strong> Thư viện hoàn tiền cọc khi trả sách $\rightarrow$ Tiền xuất từ Quỹ thư viện ra Độc giả.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function chuyenHuongDongTien(huong) {
            var isRa = (huong === 'NguonRa');
            document.getElementById('inputHuongDongTien').value = isRa ? 'Nguồn ra' : 'Nguồn vào';
            document.getElementById('badgeHuong').innerText = isRa ? 'Nguồn ra' : 'Nguồn vào';
            document.getElementById('badgeHuong').className = 'badge ' + (isRa ? 'bg-danger' : 'bg-primary');

            var groupVao = document.getElementById('groupMucDichNguonVao');
            var groupRa = document.getElementById('groupMucDichNguonRa');
            var groupTaiKhoanDoiUng = document.getElementById('groupTaiKhoanDoiUng');
            var btnSubmit = document.getElementById('btnSubmit');

            if (isRa) {
                groupVao.style.display = 'none';
                groupRa.style.display = 'flex';
                groupTaiKhoanDoiUng.style.display = 'block';

                document.getElementById('inputNguonTienRa').value = 'Quỹ tiền mặt quầy thủ thư';
                document.getElementById('inputNguonTienVao').value = 'Tiền mặt độc giả nhận tại quầy';
                document.getElementById('optHoanCoc').checked = true;
                document.getElementById('inputSoTien').value = 100000;
                btnSubmit.className = 'btn btn-danger btn-lg fs-6 py-2 fw-bold';
                btnSubmit.innerText = '📤 Xác Nhận Xuất Chi / Hoàn Tiền';
            } else {
                groupVao.style.display = 'flex';
                groupRa.style.display = 'none';
                groupTaiKhoanDoiUng.style.display = 'none';

                document.getElementById('inputNguonTienRa').value = 'Tài khoản cá nhân độc giả (Chuyển khoản QR)';
                document.getElementById('inputNguonTienVao').value = 'Tài khoản MB Bank thư viện (21611611116 - NGUYEN XUAN TRUONG)';
                document.getElementById('optTienCoc').checked = true;
                document.getElementById('inputSoTien').value = 100000;
                btnSubmit.className = 'btn btn-success btn-lg fs-6 py-2 fw-bold';
                btnSubmit.innerText = '✅ Tôi Đã Chuyển Khoản / Nộp Tiền Thành Công';
            }

            capNhatSoDo();
            capNhatGiaTri();
        }

        function chonLoaiPhi(loai, soTien) {
            if (soTien > 0) {
                document.getElementById('inputSoTien').value = soTien;
            }
            capNhatGiaTri();
        }

        function capNhatSoDo() {
            var ra = document.getElementById('inputNguonTienRa').value || 'Chưa chọn';
            var vao = document.getElementById('inputNguonTienVao').value || 'Chưa chọn';
            document.getElementById('displayNguonRa').innerText = ra;
            document.getElementById('displayNguonVao').innerText = vao;
        }

        function doiPhuongThuc(pt) {
            var isRa = document.getElementById('inputHuongDongTien').value === 'Nguồn ra';
            if (pt === 'TienMat') {
                if (isRa) {
                    document.getElementById('inputNguonTienRa').value = 'Quỹ tiền mặt quầy thủ thư';
                    document.getElementById('inputNguonTienVao').value = 'Tiền mặt độc giả nhận tại quầy';
                } else {
                    document.getElementById('inputNguonTienRa').value = 'Tiền mặt độc giả nộp tại quầy';
                    document.getElementById('inputNguonTienVao').value = 'Quỹ tiền mặt quầy thủ thư';
                }
            } else if (pt === 'MBBank') {
                if (isRa) {
                    document.getElementById('inputNguonTienRa').value = 'Tài khoản MB Bank thư viện (21611611116 - NGUYEN XUAN TRUONG)';
                    document.getElementById('inputNguonTienVao').value = 'Tài khoản ngân hàng của độc giả / sinh viên';
                } else {
                    document.getElementById('inputNguonTienRa').value = 'Tài khoản cá nhân độc giả (Chuyển khoản QR)';
                    document.getElementById('inputNguonTienVao').value = 'Tài khoản MB Bank thư viện (21611611116 - NGUYEN XUAN TRUONG)';
                }
            } else if (pt === 'MoMo') {
                if (isRa) {
                    document.getElementById('inputNguonTienRa').value = 'Ví MoMo thư viện (09******498)';
                    document.getElementById('inputNguonTienVao').value = 'Ví MoMo của độc giả';
                } else {
                    document.getElementById('inputNguonTienRa').value = 'Ví MoMo của độc giả';
                    document.getElementById('inputNguonTienVao').value = 'Ví MoMo thư viện (09******498)';
                }
            }
            capNhatSoDo();
        }

        function capNhatGiaTri() {
            var soTien = document.getElementById('inputSoTien').value;
            var formatted = new Intl.NumberFormat('vi-VN').format(soTien || 0) + ' đ';
            var displays = document.querySelectorAll('.display-amount');
            displays.forEach(function (el) {
                el.innerText = formatted;
            });

            var hoTen = document.getElementById('inputHoTen').value.trim();
            var slug = hoTen ? boDau(hoTen).replace(/\s+/g, '').toUpperCase() : 'SV';
            var currentNoiDung = document.getElementById('inputNoiDung').value;

            if (!currentNoiDung.includes('PM')) {
                var isRa = document.getElementById('inputHuongDongTien').value === 'Nguồn ra';
                var prefix = isRa ? 'HOANCOC' : 'PHI';
                document.getElementById('inputNoiDung').value = 'UNETI ' + prefix + ' ' + slug + ' ' + (soTien || '');
            }
        }

        function boDau(str) {
            return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d").replace(/Đ/g, "D");
        }

        function copyNoiDung() {
            var noiDung = document.getElementById('inputNoiDung').value;
            navigator.clipboard.writeText(noiDung).then(function() {
                alert('Đã sao chép nội dung: "' + noiDung + '"');
            });
        }

        function copyText(txt, msg) {
            navigator.clipboard.writeText(txt).then(function() {
                alert(msg);
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            capNhatSoDo();
            capNhatGiaTri();
        });
    </script>
}
